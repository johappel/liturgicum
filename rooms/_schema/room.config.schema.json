{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liturgicum.local/room.config.schema.json",
  "title": "RoomConfig",
  "description": "Datengetriebene Konfiguration eines Resonanz-Raums.",
  "type": "object",
  "required": ["version", "id", "title", "background", "zones", "perspective"],
  "additionalProperties": true,
  "definitions": {
    "normPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "polygon": {
      "type": "array",
      "items": { "$ref": "#/definitions/normPoint" }
    },
    "zone": {
      "type": "object",
      "required": ["polygons"],
      "properties": {
        "polygons": { "type": "array", "items": { "$ref": "#/definitions/polygon" } }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "background": { "type": "string" },
    "ambient": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "src", "volume", "loop", "fadeMs"],
        "properties": {
          "id": { "type": "string" },
          "src": { "type": "string" },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 },
          "loop": { "type": "boolean" },
          "fadeMs": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "effect", "intensity", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "effect": { "type": "string" },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "position": { "$ref": "#/definitions/normPoint" },
          "params": { "type": "object" },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "interaction", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "interaction": { "type": "string" },
          "zone": { "type": "string" },
          "artifacts": { "type": "array", "items": { "type": "string" } },
          "sounds": { "type": "object" },
          "params": { "type": "object" },
          "enabled": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/zone" }
    },
    "perspective": {
      "type": "object",
      "required": ["vanishingPoint", "referencePoint", "minScale", "nearScale"],
      "properties": {
        "vanishingPoint": { "$ref": "#/definitions/normPoint" },
        "referencePoint": { "$ref": "#/definitions/normPoint" },
        "minScale": { "type": "number" },
        "nearScale": { "type": "number" }
      },
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxSpawns": { "type": "integer", "minimum": 0 },
        "firstDelayMsMin": { "type": "number", "minimum": 0 },
        "firstDelayMsMax": { "type": "number", "minimum": 0 },
        "maxForeignTraceArtifacts": { "type": "integer", "minimum": 0 },
        "hushSound": { "type": "string" },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "silhouette", "weight", "baseHeight"],
            "properties": {
              "kind": { "type": "string" },
              "silhouette": { "type": "string" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "baseHeight": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "randomEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled", "kind", "ref", "intervalMsMin", "intervalMsMax"],
        "properties": {
          "id": { "type": "string" },
          "enabled": { "type": "boolean" },
          "kind": { "type": "string", "enum": ["sound", "interaction"] },
          "ref": { "type": "string" },
          "intervalMsMin": { "type": "number", "minimum": 0 },
          "intervalMsMax": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "intro": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "audio": { "type": "string" },
        "durationMs": { "type": "number", "minimum": 0 },
        "lines": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "speaker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "audio": { "type": "string" },
        "text": { "type": "string" },
        "fallbackMs": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dwellGate": {
      "type": "object",
      "properties": {
        "minDwellSeconds": { "type": "number", "minimum": 0 },
        "exitHint": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
