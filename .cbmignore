# codebase-memory-mcp project-specific exclusions
# Core repo noise / generated content
.git/
app/node_modules/
app/dist/
graphify-out/

# Source maps and common build artifacts
*.map
*.tsbuildinfo
*.pyc
__pycache__/
dist/
build/
out/
coverage/
*.min.js
*.min.css

# Media files
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.bmp
*.ico
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.mp4
*.mov
*.avi
*.mkv
